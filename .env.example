# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (Project Settings → API Keys) ────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose to the browser
SUPABASE_SECRET_KEY=

# ─── Stripe ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the paid weekly brief (monthly / yearly)
STRIPE_PRICE_BRIEF_MONTHLY=
STRIPE_PRICE_BRIEF_YEARLY=

# ─── Licensed sports data (ADR-0001) ───────────────────
# "mock"         — nothing connected (no games shown)
# "espn"         — ESPN public scoreboard, DEV PREVIEW ONLY (unlicensed; disabled on Vercel production)
# "sportsdataio" — licensed provider (ADR-0001)
SPORTS_DATA_PROVIDER=mock
SPORTSDATAIO_API_KEY=
# UI-only random fixtures (no scores). Leave false so visitors never see fake games.
DEMO_SCHEDULE=false

# ─── Vercel Cron ───────────────────────────────────────
# Vercel sends `Authorization: Bearer $CRON_SECRET` to cron routes
CRON_SECRET=

# ─── Resend (email) ────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Sports <hello@example.com>"
# Licensed partner travel agency that receives trip inquiries
PARTNER_AGENCY_EMAIL=

# ─── Business flags ────────────────────────────────────
# Flip to "true" only after the 2026 MLB CBA is signed (UC-03)
MLB_CBA_SETTLED=false
